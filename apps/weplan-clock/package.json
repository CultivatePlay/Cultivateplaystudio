{
  "name": "weplan-clock-app",
  "version": "1.0.0",
  "private": true,
  "description": "WePlan Clock for iPhone, iPad and Android. The app code lives in ../../weplan-clock; this project wraps it with Capacitor.",
  "scripts": {
    "build": "node scripts/copy-web.mjs",
    "sync": "npm run build && cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#2E5AAE' --iconBackgroundColorDark '#1C2925' --splashBackgroundColor '#2E5AAE' --splashBackgroundColorDark '#1C2925'"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "cordova-plugin-purchase": "^13.20.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
